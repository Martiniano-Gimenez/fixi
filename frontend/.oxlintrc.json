{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true
  },
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.js",
        "src/**/*.jsx"
      ],
      "excludeFiles": [
        "src/utils/dateUtils.js"
      ],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "property": "getHours",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getMinutes",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getDay",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getDate",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getMonth",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getFullYear",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "toLocaleTimeString",
            "message": "Usar formatHora() de frontend/src/utils/dateUtils.js"
          },
          {
            "property": "toLocaleDateString",
            "message": "Usar formatFechaTorneo() de frontend/src/utils/dateUtils.js"
          },
          {
            "property": "toLocaleString",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "setHours",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "setMinutes",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "setDate",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "setMonth",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "setFullYear",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "property": "getTimezoneOffset",
            "message": "Usar frontend/src/utils/dateUtils.js"
          },
          {
            "object": "Date",
            "property": "parse",
            "message": "Usar frontend/src/utils/dateUtils.js"
          }
        ]
      }
    }
  ]
}