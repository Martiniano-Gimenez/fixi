// Fixi — Schema completo del MVP (Adaptado para SQLite en Local)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Modelos ─────────────────────────────────────────────

model Organizador {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nombre       String
  createdAt    DateTime @default(now())

  // Configuración de jornada y canchas a nivel club
  cantidadCanchas  Int     @default(1)
  viernesInicio    String? // "13:00" — null = no se juega viernes
  viernesFin       String? // "21:00"
  sabadoInicio     String? // "09:00" — null = no se juega sábado
  sabadoFin        String? // "20:00"
  domingoInicio    String? // "08:00" — null = no se juega domingo
  domingoFin       String? // "21:00"

  torneos Torneo[]
}

model Torneo {
  id             String    @id @default(uuid())
  organizadorId  String
  nombre         String
  fecha          DateTime?
  slug           String    @unique
  estado                     String    @default("BORRADOR") // "BORRADOR" | "EN_CURSO" | "FINALIZADO"
  canchasDisponiblesOverride Int? // null = usar club.cantidadCanchas
  overrideActivoDesde        DateTime? // timestamp de activación del override actual
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  organizador    Organizador @relation(fields: [organizadorId], references: [id])
  categorias     Categoria[]
}

model Categoria {
  id        String   @id @default(uuid())
  torneoId  String
  nombre    String   // "4ta", "6ta", "8va", "5ta Damas", etc.
  estado    String   @default("BORRADOR") // "BORRADOR" | "EN_CURSO" | "FINALIZADO"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  torneo             Torneo             @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  parejas            Pareja[]
  zonas              Zona[]
  fasesEliminatorias FaseEliminatoria[]
  partidos           Partido[]
}

model Pareja {
  id               String @id @default(uuid())
  categoriaId      String
  jugador1         String
  jugador2         String
  orden            Int    @default(0)
  resolucionManual Boolean @default(false)

  categoria          Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  zonaParejas        ZonaPareja[]
  partidosComoP1     Partido[]    @relation("Pareja1")
  partidosComoP2     Partido[]    @relation("Pareja2")
  partidosGanados    Partido[]    @relation("Ganador")
  slotsSeleccionados SlotPareja[]
}

// Selección de slots de disponibilidad por pareja
model SlotPareja {
  id        String @id @default(uuid())
  parejaId  String
  slotId    String // "Viernes-13:00", "Sabado-09:00", etc.

  pareja Pareja @relation(fields: [parejaId], references: [id], onDelete: Cascade)

  @@unique([parejaId, slotId])
}

model Zona {
  id                   String  @id @default(uuid())
  categoriaId          String
  nombre               String  // "Zona A", "Zona B", etc.
  clasifican           Int     @default(2)
  formato              String  @default("ROUND_ROBIN") // "ROUND_ROBIN" | "MINI_BRACKET"
  requiereArmadoManual Boolean @default(false)

  categoria   Categoria    @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  zonaParejas ZonaPareja[]
  partidos    Partido[]
}

model ZonaPareja {
  id        String @id @default(uuid())
  zonaId    String
  parejaId  String
  posicion  Int    @default(0) // Posición final en la zona (1ro, 2do, etc.)
  pj        Int    @default(0) // Partidos jugados
  pg        Int    @default(0) // Partidos ganados
  pp        Int    @default(0) // Partidos perdidos
  sf        Int    @default(0) // Sets a favor
  sc        Int    @default(0) // Sets en contra
  gf        Int    @default(0) // Games a favor
  gc        Int    @default(0) // Games en contra
  puntos    Int    @default(0) // 3 por victoria, 0 por derrota

  zona   Zona   @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  pareja Pareja @relation(fields: [parejaId], references: [id], onDelete: Cascade)

  @@unique([zonaId, parejaId])
}

model FaseEliminatoria {
  id          String @id @default(uuid())
  categoriaId String
  nombre      String // "Cuartos de Final", "Semifinal", "Final"
  ronda       Int    // 1=final, 2=semis, 4=cuartos, 8=octavos...

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  partidos  Partido[]
}

model Partido {
  id                 String    @id @default(uuid())
  categoriaId        String
  zonaId             String?   // Si es partido de zona
  faseEliminatoriaId String?   // Si es partido de eliminatoria
  posicionEnRonda    Int       @default(1) // Ubicación en el cuadro
  pareja1Id          String?   // Nullable hasta que se conozca
  origenPareja1      String?   // Ej: "1°A", "2°B"
  pareja2Id          String?   // Nullable hasta que se conozca
  origenPareja2      String?   // Ej: "1°A", "2°B"
  ganadorId          String?   // Nullable hasta que se juegue
  estado             String    @default("PENDIENTE") // "PENDIENTE" | "EN_CURSO" | "FINALIZADO"
  fechaHora          DateTime?
  canchaNumero       Int?
  sinHorarioAsignado Boolean   @default(false)

  categoria        Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  zona             Zona?             @relation(fields: [zonaId], references: [id], onDelete: SetNull)
  faseEliminatoria FaseEliminatoria? @relation(fields: [faseEliminatoriaId], references: [id], onDelete: SetNull)
  pareja1          Pareja?           @relation("Pareja1", fields: [pareja1Id], references: [id], onDelete: SetNull)
  pareja2          Pareja?           @relation("Pareja2", fields: [pareja2Id], references: [id], onDelete: SetNull)
  ganador          Pareja?           @relation("Ganador", fields: [ganadorId], references: [id], onDelete: SetNull)
  sets             SetPartido[]
}

model SetPartido {
  id           String @id @default(uuid())
  partidoId    String
  numero       Int    // 1, 2 o 3
  gamesPareja1 Int
  gamesPareja2 Int

  partido Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)

  @@unique([partidoId, numero])
}
